# POXY-GEN1 editor defaults.
# Line endings are intentionally not forced here: the repo predates this file
# and mixes CRLF (Windows-authored) with LF (scaffolded) content. Git handles
# the working copy; do not mass-convert existing files.
root = true

[*]
charset = utf-8
insert_final_newline = true
indent_style = space
indent_size = 2
trim_trailing_whitespace = true

[*.md]
trim_trailing_whitespace = false

[*.{sql,ps1}]
indent_size = 4
