{
  "$meta": {
    "system": "POXY Codex tokens - Still Water v1.1",
    "authority": "docs/10-BRAND.md (The POXY Codex). Values are LOCKED; changes require an ADR.",
    "build": "node packages/tokens/build.mjs regenerates css/variables.css. Never hand-edit the CSS.",
    "quarantine": "Rarity pigments appear ONLY in gem SVGs, RarityBadge, and the reveal glow. Never on buttons, backgrounds, text links, or charts."
  },
  "color": {
    "core": {
      "paper": "#F0F0F1",
      "paper-raised": "#FFFFFF",
      "paper-sunken": "#E6E7E9",
      "ink": "#1C1C1E",
      "ink-soft": "#3A3A3F",
      "vault-deep": "#101014",
      "vault-abyss": "#0A0A0D",
      "sky-100": "#EAF7FB",
      "sky-300": "#A8DEED",
      "sky-500": "#60C2E0",
      "sky-700": "#2E8FAD",
      "sky-900": "#17546A"
    },
    "pigment": {
      "common": { "hex": "#8E9196", "pigment": "Nezumi", "kanji": "鼠" },
      "uncommon": { "hex": "#57A17C", "pigment": "Rokushō", "kanji": "緑青" },
      "rare": { "hex": "#3D6BC6", "pigment": "Ruri", "kanji": "瑠璃" },
      "epic": { "hex": "#8A5BC4", "pigment": "Murasaki", "kanji": "紫" },
      "legendary": { "hex": "#D9A441", "pigment": "Kin", "kanji": "金" },
      "mythic": { "hex": "#C43A50", "pigment": "Akane", "kanji": "茜" }
    },
    "functional": {
      "success": "#4E9D74",
      "danger": "#C24A55",
      "warning": "#D9A441"
    }
  },
  "env": {
    "gallery": {
      "surface": "var(--px-paper)",
      "surface-raised": "var(--px-paper-raised)",
      "surface-sunken": "var(--px-paper-sunken)",
      "text": "var(--px-ink)",
      "text-dim": "var(--px-ink-soft)",
      "hairline": "rgba(28, 28, 30, 0.12)",
      "glass-bg": "rgba(255, 255, 255, 0.72)",
      "glass-border": "rgba(28, 28, 30, 0.08)",
      "glow": "rgba(96, 194, 224, 0.18)",
      "shadow": "0 1px 2px rgba(28, 28, 30, 0.06)"
    },
    "vault": {
      "surface": "var(--px-vault-deep)",
      "surface-raised": "rgba(240, 240, 241, 0.06)",
      "surface-sunken": "var(--px-vault-abyss)",
      "text": "var(--px-paper)",
      "text-dim": "rgba(240, 240, 241, 0.60)",
      "hairline": "rgba(240, 240, 241, 0.10)",
      "glass-bg": "rgba(240, 240, 241, 0.06)",
      "glass-border": "rgba(240, 240, 241, 0.12)",
      "glow": "rgba(96, 194, 224, 0.25)",
      "shadow": "0 8px 32px rgba(0, 0, 0, 0.50)"
    }
  },
  "space": { "4": "4px", "8": "8px", "16": "16px", "24": "24px", "32": "32px", "40": "40px", "48": "48px", "64": "64px" },
  "radius": { "8": "8px", "12": "12px", "16": "16px", "24": "24px", "full": "999px" },
  "type": {
    "families": {
      "display": "'Fraunces', Georgia, 'Times New Roman', serif",
      "ui": "'Inter', -apple-system, BlinkMacSystemFont, 'Segoe UI', system-ui, sans-serif",
      "data": "'Space Grotesk', 'Inter', system-ui, sans-serif",
      "mono": "'JetBrains Mono', ui-monospace, 'Cascadia Mono', Consolas, monospace"
    },
    "roles": {
      "display": { "family": "display", "size": "40px", "line": "44px", "weight": "560", "tracking": "-0.01em" },
      "title": { "family": "display", "size": "28px", "line": "34px", "weight": "540", "tracking": "-0.01em" },
      "heading": { "family": "ui", "size": "20px", "line": "26px", "weight": "600", "tracking": "0" },
      "body": { "family": "ui", "size": "16px", "line": "24px", "weight": "400", "tracking": "0" },
      "caption": { "family": "ui", "size": "13px", "line": "18px", "weight": "400", "tracking": "0.01em" },
      "data-l": { "family": "data", "size": "32px", "line": "36px", "weight": "500", "tracking": "0" },
      "data-m": { "family": "data", "size": "15px", "line": "20px", "weight": "500", "tracking": "0" },
      "mono": { "family": "mono", "size": "13px", "line": "20px", "weight": "400", "tracking": "0" }
    }
  },
  "motion": {
    "dur-surface": "200ms",
    "dur-current": "320ms",
    "ease-surface": "cubic-bezier(0.2, 0, 0, 1)",
    "ease-current": "cubic-bezier(0.32, 0.72, 0, 1)",
    "ease-ritual": "cubic-bezier(0.34, 1.30, 0.5, 1)"
  },
  "layout": {
    "rail-w": "74px",
    "content-max": "680px",
    "card-ratio": "3 / 4"
  }
}
